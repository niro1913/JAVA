//Greater between three number
import java .util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        double d1= sc.nextDouble();
        double d2=sc.nextDouble();
        double d3=sc.nextDouble();
        if(d1>d2&&d1>d3)
        System.out.println("Greater number: "+d1);
        else if(d2>d1&&d2>d3)
        System.out.println("Greater number: "+d2);
        else if(d3>d1&&d3>d2)
        System.out.println("Greater number: "+d3);
    }
}
